---
import cfg from '../data/wedding.ts';
import { isPlaceholder } from '../data/wedding.ts';
import Star from './decorations/Star.astro';
import Flower from './decorations/Flower.astro';

const items = cfg.accommodation;
const allPlaceholder = items.every((i) => isPlaceholder(i.name));
---

<section id="alojamiento" class="stay" data-bg="pink">
  <div class="stay__decor" aria-hidden="true">
    <Flower size="180" color="#5423A6" accent="#FFD84D" rotate={20} className="stay__flower stay__flower--1" />
    <Star size="56" color="#FFD84D" points={8} rotate={-12} className="stay__star" />
  </div>

  <div class="container stay__container">
    <div class="stay__header reveal">
      <span class="eyebrow"><span aria-hidden="true">☾</span> 04 · Dónde dormir</span>
      <h2 class="stay__title section-title">{cfg.copy.accommodationHeading}</h2>
      <p class="stay__lead">{cfg.copy.accommodationCopy}</p>
    </div>

    <ul class="stay__list stagger" role="list">
      {items.map((a, idx) => {
        const placeholder = isPlaceholder(a.name);
        const hasUrl = !isPlaceholder(a.url ?? '');
        return (
          <li class="stay__card">
            <div class="stay__card-head">
              <span class="stay__num">0{idx + 1}</span>
              <h3>{placeholder ? 'Próximamente' : a.name}</h3>
            </div>
            {a.description && <p class="stay__desc">{a.description}</p>}
            <ul class="stay__meta" role="list">
              {a.town && <li><span>Localidad</span><strong>{a.town}</strong></li>}
              {a.distance && <li><span>Distancia</span><strong>{a.distance}</strong></li>}
              {a.booking && <li><span>Reserva</span><strong>{a.booking}</strong></li>}
            </ul>
            {a.note && <p class="stay__note">{a.note}</p>}
            {hasUrl ? (
              <a class="btn btn--ghost" href={a.url} target="_blank" rel="noopener noreferrer">
                Ver alojamiento <span aria-hidden="true">↗</span>
              </a>
            ) : (
              <span class="stay__placeholder-tag">Próximamente</span>
            )}
          </li>
        );
      })}
    </ul>

    {allPlaceholder && (
      <p class="stay__soon reveal">
        Estamos negociando con alojamientos locales para conseguir las mejores condiciones. ¡Vuelve pronto!
      </p>
    )}
  </div>
</section>

<style>
  .stay {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--c-pink);
    color: var(--c-black);
    padding: var(--section-pad-y) 0;
  }

  .stay__decor { position: absolute; inset: 0; z-index: 0; pointer-events: none; }
  .stay__decor :global(.stay__flower--1) {
    position: absolute;
    bottom: 4%;
    right: 4%;
    animation: float 7s ease-in-out infinite;
  }
  .stay__decor :global(.stay__star) {
    position: absolute;
    top: 8%;
    left: 6%;
    animation: spin-slow 18s linear infinite;
  }

  .stay__container { position: relative; z-index: 1; }
  .stay__header { text-align: center; max-width: 36rem; margin: 0 auto 2.5rem; }
  .stay__title { color: var(--c-black); margin-top: 0.6rem; }
  .stay__lead { margin-top: 1rem; font-size: 1.1rem; line-height: 1.4; }

  .stay__list {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  .stay__card {
    background: var(--c-cream);
    color: var(--c-black);
    border: 4px solid var(--c-black);
    border-radius: var(--br-lg);
    padding: clamp(1.2rem, 2.5vw, 1.8rem);
    box-shadow: var(--shadow-2);
    transition: transform var(--d-med) var(--ease-snap), box-shadow var(--d-med);
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    position: relative;
  }
  .stay__card:nth-child(odd) { transform: rotate(-1.2deg); }
  .stay__card:nth-child(even) { transform: rotate(1.2deg); }
  .stay__card:hover {
    transform: translateY(-4px) rotate(0);
    box-shadow: var(--shadow-3);
  }
  .stay__card-head { display: flex; align-items: center; gap: 0.6rem; }
  .stay__num {
    font-family: var(--ff-display);
    font-size: 1.5rem;
    background: var(--c-black);
    color: var(--c-butter);
    width: 2.2rem;
    height: 2.2rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
  }
  .stay__card h3 {
    font-family: var(--ff-display);
    font-size: clamp(1.3rem, 3vw, 1.7rem);
    line-height: 1;
  }
  .stay__desc { font-size: 1rem; line-height: 1.4; }
  .stay__meta {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    border-top: 2px dashed var(--c-black);
    padding-top: 0.6rem;
  }
  .stay__meta li {
    display: flex;
    justify-content: space-between;
    gap: 0.5rem;
    font-size: 0.95rem;
  }
  .stay__meta span {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--c-purple);
  }
  .stay__note {
    font-size: 0.9rem;
    color: var(--c-black);
    font-style: italic;
  }
  .stay__placeholder-tag {
    align-self: flex-start;
    background: var(--c-black);
    color: var(--c-butter);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
  }
  .stay__soon {
    margin-top: 2rem;
    text-align: center;
    background: var(--c-black);
    color: var(--c-butter);
    padding: 1rem 1.4rem;
    border-radius: var(--br-md);
    font-weight: 600;
  }

  @media (min-width: 700px) {
    .stay__list { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 980px) {
    .stay__list { grid-template-columns: repeat(3, 1fr); }
  }
</style>
