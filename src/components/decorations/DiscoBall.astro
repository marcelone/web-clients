---
/**
 * DiscoBall — SVG disco ball with rotating reflective facets.
 * Pure SVG + CSS animation. Respects prefers-reduced-motion.
 */
interface Props {
  size?: number | string;
  color?: string;
  accent?: string;
  className?: string;
  speed?: number; // seconds per rotation
  style?: string;
}
const {
  size = 280,
  color = '#FFD84D',
  accent = '#FFF5DF',
  className = '',
  speed = 30,
  style = '',
} = Astro.props;
---

<div
  class={`disco-ball ${className}`}
  style={`width:${size};height:${size};${style}`}
  aria-hidden="true"
>
  <svg viewBox="0 0 200 200" class="disco-ball__svg">
    <defs>
      <radialGradient id="db-shine" cx="0.35" cy="0.3" r="0.8">
        <stop offset="0%" stop-color={accent} stop-opacity="0.95" />
        <stop offset="55%" stop-color={color} />
        <stop offset="100%" stop-color="#191414" />
      </radialGradient>
      <clipPath id="db-clip">
        <circle cx="100" cy="100" r="86" />
      </clipPath>
    </defs>

    <g class="disco-ball__rotor" style={`animation-duration:${speed}s`}>
      <circle cx="100" cy="100" r="86" fill="url(#db-shine)" />
      <g clip-path="url(#db-clip)" stroke="#191414" stroke-opacity="0.45" stroke-width="1.1">
        {/* Facet pattern */}
        {Array.from({ length: 12 }).map((_, r) => (
          <line
            x1="0"
            y1={100 - 86 + r * (172 / 12)}
            x2="200"
            y2={100 - 86 + r * (172 / 12)}
          />
        ))}
        {Array.from({ length: 16 }).map((_, c) => {
          const x = (c * 200) / 16 - 6;
          return <line x1={x} y1="0" x2={x + 60} y2="200" />;
        })}
        {/* specular highlights */}
        {Array.from({ length: 14 }).map((_, i) => {
          const a = (i / 14) * Math.PI * 2;
          const cx = 100 + Math.cos(a) * 70;
          const cy = 100 + Math.sin(a) * 70;
          return <circle cx={cx} cy={cy} r="3.4" fill={accent} opacity="0.8" />;
        })}
      </g>
      <circle cx="100" cy="100" r="86" fill="none" stroke="#191414" stroke-width="3" />
    </g>

    {/* Top hanger */}
    <line x1="100" y1="0" x2="100" y2="14" stroke="#191414" stroke-width="3" />
    <rect x="92" y="14" width="16" height="6" fill="#191414" rx="1" />
  </svg>
</div>

<style>
  .disco-ball {
    display: inline-block;
    position: relative;
    filter: drop-shadow(0 10px 18px rgba(25, 20, 20, 0.25));
  }
  .disco-ball__svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .disco-ball__rotor {
    transform-origin: 100px 100px;
    animation: spin-slow 30s linear infinite;
  }
  @media (prefers-reduced-motion: reduce) {
    .disco-ball__rotor {
      animation: none;
    }
  }
</style>
