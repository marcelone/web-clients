---
/**
 * Star — 4-point or 8-point retro star.
 */
interface Props {
  size?: number | string;
  color?: string;
  outline?: string;
  points?: 4 | 8;
  rotate?: number;
  className?: string;
}
const {
  size = 60,
  color = '#FFD84D',
  outline = '#191414',
  points = 4,
  rotate = 0,
  className = '',
} = Astro.props;

const id = `star-${Math.random().toString(36).slice(2, 9)}`;

const starPath = (n: number) => {
  const pts: string[] = [];
  const total = n * 2;
  for (let i = 0; i < total; i++) {
    const r = i % 2 === 0 ? 90 : 38;
    const a = (Math.PI * 2 * i) / total - Math.PI / 2;
    pts.push(`${100 + Math.cos(a) * r},${100 + Math.sin(a) * r}`);
  }
  return `M ${pts.join(' L ')} Z`;
};
---

<svg
  viewBox="0 0 200 200"
  width={size}
  height={size}
  class={`star ${className}`}
  style={`transform:rotate(${rotate}deg)`}
  aria-hidden="true"
>
  <path
    d={starPath(points)}
    fill={color}
    stroke={outline}
    stroke-width="6"
    stroke-linejoin="round"
  />
</svg>

<style>
  .star {
    overflow: visible;
    filter: drop-shadow(0 4px 0 rgba(25, 20, 20, 0.85));
  }
</style>
