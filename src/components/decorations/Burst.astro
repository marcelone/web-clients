---
/**
 * Burst — 70s sunburst / sticker explosion.
 * Concentric arcs and rays.
 */
interface Props {
  size?: number | string;
  color?: string;
  accent?: string;
  rotate?: number;
  className?: string;
}
const {
  size = 200,
  color = '#FF65B3',
  accent = '#FFD84D',
  rotate = 0,
  className = '',
} = Astro.props;
---

<svg
  viewBox="0 0 200 200"
  width={size}
  height={size}
  class={`burst ${className}`}
  style={`transform:rotate(${rotate}deg)`}
  aria-hidden="true"
>
  {Array.from({ length: 18 }).map((_, i) => {
    const a = (i / 18) * 360;
    return (
      <g transform={`rotate(${a} 100 100)`}>
        <path d="M100,18 L106,80 L100,72 L94,80 Z" fill={i % 2 ? color : accent} stroke="#191414" stroke-width="2" />
      </g>
    );
  })}
  <circle cx="100" cy="100" r="34" fill="#FFF5DF" stroke="#191414" stroke-width="3" />
  <circle cx="100" cy="100" r="20" fill={color} stroke="#191414" stroke-width="3" />
</svg>

<style>
  .burst {
    overflow: visible;
  }
</style>
