---
import cfg from '../data/wedding.ts';
import { isPlaceholder } from '../data/wedding.ts';
import Flower from './decorations/Flower.astro';
import Star from './decorations/Star.astro';
import Burst from './decorations/Burst.astro';

const reqIsPlaceholder = isPlaceholder(cfg.dressCode.requirement);
---

<section id="dresscode" class="dress" data-bg="butter">
  <div class="dress__decor" aria-hidden="true">
    <Flower size="160" color="#5423A6" accent="#FF65B3" variant="b" rotate={-15} className="dress__flower dress__flower--1" />
    <Flower size="110" color="#FF65B3" accent="#FFD84D" rotate={20} className="dress__flower dress__flower--2" />
    <Star size="60" color="#5423A6" rotate={10} className="dress__star" />
    <Burst size="140" color="#FF651F" accent="#5423A6" rotate={15} className="dress__burst" />
  </div>

  <div class="container dress__container">
    <div class="dress__copy">
      <span class="eyebrow reveal"><span aria-hidden="true">✺</span> 02 · Cómo venir</span>
      <h2 class="dress__title section-title reveal">{cfg.copy.dressHeading}</h2>
      <p class="dress__lead reveal">{cfg.copy.dressCopy}</p>

      <div class="dress__chips reveal">
        <span class="chip">Brillos ✨</span>
        <span class="chip">Puraspurpurina</span>
        <span class="chip">Disco vibes</span>
        <span class="chip">Tacones opcionales</span>
        <span class="chip">Ganas infinitas</span>
      </div>

      <div class="dress__sticker reveal">
        <span class="dress__sticker-label">Dress code</span>
        <strong class="dress__sticker-value">
          {reqIsPlaceholder ? 'Próximamente' : cfg.dressCode.requirement}
        </strong>
        <span class="dress__sticker-note">{cfg.dressCode.note}</span>
      </div>
    </div>

    <div class="dress__board reveal">
      <div class="dress__board-frame">
        <div class="dress__board-tag">Look del día</div>
        <ul class="dress__looks stagger">
          <li>
            <span class="dress__look-num">01</span>
            <strong>Brillos, lentejuelas y purpurina</strong>
            <small>Cuanto más, mejor. Esto no es una junta de vecinos.</small>
          </li>
          <li>
            <span class="dress__look-num">02</span>
            <strong>Disco total look</strong>
            <small>Campana, terciopelo, plataforma, color. Lo que sea.</small>
          </li>
          <li>
            <span class="dress__look-num">03</span>
            <strong>Tu versión favorita de ti</strong>
            <small>Si vienes seguro/a, vienes perfecto/a.</small>
          </li>
          <li>
            <span class="dress__look-num">04</span>
            <strong>Olvida las etiquetas</strong>
            <small>Lleva lo que te haga sentir increíble.</small>
          </li>
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .dress {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--c-butter);
    color: var(--c-black);
    padding: var(--section-pad-y) 0;
  }

  .dress__decor { position: absolute; inset: 0; z-index: 0; pointer-events: none; }
  .dress__decor :global(.dress__flower--1) { position: absolute; top: 6%; right: -6%; width: clamp(100px, 18vw, 160px); }
  .dress__decor :global(.dress__flower--2) { position: absolute; bottom: 8%; left: -4%; width: clamp(80px, 14vw, 110px); animation: float 7s ease-in-out infinite; }
  .dress__decor :global(.dress__star) { position: absolute; top: 30%; left: 6%; animation: spin-slow 18s linear infinite; }
  .dress__decor :global(.dress__burst) { position: absolute; bottom: 4%; right: 4%; animation: spin-slow 30s linear infinite; opacity: 0.85; }

  .dress__container {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    align-items: center;
  }

  .dress__title {
    margin-top: 0.6rem;
    color: var(--c-black);
    transform: rotate(-1.5deg);
    display: inline-block;
  }
  .dress__lead {
    margin-top: 1rem;
    font-size: clamp(1.1rem, 2vw, 1.35rem);
    line-height: 1.4;
    max-width: 38ch;
  }

  .dress__chips {
    margin-top: 1.2rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .dress__chips .chip {
    background: var(--c-black);
    color: var(--c-butter);
  }
  .dress__chips .chip:nth-child(2) { background: var(--c-pink); color: var(--c-black); }
  .dress__chips .chip:nth-child(3) { background: var(--c-purple); color: var(--c-butter); }
  .dress__chips .chip:nth-child(4) { background: var(--c-cream); color: var(--c-black); }
  .dress__chips .chip:nth-child(5) { background: var(--c-orange); color: var(--c-black); }

  .dress__sticker {
    margin-top: 1.5rem;
    display: inline-flex;
    flex-direction: column;
    gap: 0.2rem;
    background: var(--c-pink);
    border: 3px solid var(--c-black);
    border-radius: var(--br-md);
    padding: 0.9rem 1.2rem;
    box-shadow: var(--shadow-2);
    transform: rotate(-2deg);
    max-width: 26rem;
  }
  .dress__sticker-label {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--c-black);
  }
  .dress__sticker-value {
    font-family: var(--ff-display);
    font-size: clamp(1.3rem, 3vw, 1.8rem);
    color: var(--c-black);
  }
  .dress__sticker-note {
    font-size: 0.85rem;
    color: var(--c-black);
    line-height: 1.3;
  }

  /* Look board */
  .dress__board {
    position: relative;
  }
  .dress__board-frame {
    background: var(--c-black);
    color: var(--c-cream);
    border-radius: var(--br-lg);
    padding: clamp(1.4rem, 3vw, 2.2rem);
    transform: rotate(2deg);
    position: relative;
  }
  .dress__board-tag {
    position: absolute;
    top: -16px;
    left: 24px;
    background: var(--c-orange);
    color: var(--c-black);
    border: 3px solid var(--c-black);
    border-radius: 999px;
    padding: 0.3rem 0.9rem;
    font-family: var(--ff-display);
    font-size: 0.95rem;
  }
  .dress__looks {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .dress__looks li {
    display: grid;
    grid-template-columns: auto 1fr;
    column-gap: 0.9rem;
    row-gap: 0.1rem;
    align-items: baseline;
    border-bottom: 1px dashed rgba(255, 245, 223, 0.25);
    padding-bottom: 0.9rem;
  }
  .dress__looks li:last-child { border-bottom: 0; padding-bottom: 0; }
  .dress__look-num {
    font-family: var(--ff-display);
    font-size: 1.6rem;
    color: var(--c-butter);
  }
  .dress__looks strong {
    font-family: var(--ff-display);
    font-size: 1.15rem;
    color: var(--c-cream);
  }
  .dress__looks small {
    grid-column: 2;
    font-size: 0.9rem;
    color: var(--c-cream);
    opacity: 0.85;
  }

  @media (min-width: 880px) {
    .dress__container {
      grid-template-columns: 1.05fr 1fr;
      gap: 4rem;
    }
  }
</style>
