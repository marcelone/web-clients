---
import cfg from '../data/wedding.ts';
import { isPlaceholder } from '../data/wedding.ts';
import Burst from './decorations/Burst.astro';
import Squiggle from './decorations/Squiggle.astro';
import Star from './decorations/Star.astro';

function whatsappLink(phone: string | null | undefined, text: string) {
  if (!phone) return null;
  const digits = phone.replace(/[^0-9+]/g, '').replace(/^\+/, '');
  return `https://wa.me/${digits}?text=${encodeURIComponent(text)}`;
}

const defaultMsg = `¡Hola! Tengo una pregunta sobre la boda 🎉`;

const contacts = cfg.contact.map((p) => ({
  ...p,
  whatsappHref: whatsappLink(p.whatsapp, defaultMsg),
  hasAny: !isPlaceholder(p.email ?? '') || !!p.whatsapp,
}));
const anyContact = contacts.some((c) => c.hasAny);
---

<section id="contacto" class="contact" data-bg="orange">
  <div class="contact__decor" aria-hidden="true">
    <Burst size="220" color="#5423A6" accent="#FFD84D" rotate={-15} className="contact__burst" />
    <Squiggle color="#191414" width="220" height="28" className="contact__squiggle" />
    <Star size="50" color="#FFD84D" rotate={15} className="contact__star" />
  </div>

  <div class="container contact__container">
    <div class="contact__header reveal">
      <span class="eyebrow"><span aria-hidden="true">✉</span> 05 · Hola</span>
      <h2 class="contact__title section-title">{cfg.copy.contactHeading}</h2>
      <p class="contact__lead">{cfg.copy.contactCopy}</p>
    </div>

    <div class="contact__grid">
      {contacts.map((c, idx) => (
        <article class={`contact__card contact__card--${idx % 2 ? 'b' : 'a'} reveal`}>
          <div class="contact__card-head">
            <span class="contact__avatar" aria-hidden="true">
              {c.name.charAt(0).toUpperCase()}
            </span>
            <div>
              <h3 class="contact__name">{c.name}</h3>
              {c.role && <span class="contact__role">{c.role}</span>}
            </div>
          </div>

          {c.hasAny ? (
            <ul class="contact__channels" role="list">
              {c.whatsappHref && (
                <li>
                  <a class="contact__channel" href={c.whatsappHref} target="_blank" rel="noopener noreferrer">
                    <span class="contact__channel-label">WhatsApp</span>
                    <span class="contact__channel-value">{c.whatsapp}</span>
                    <span class="contact__channel-arrow" aria-hidden="true">→</span>
                  </a>
                </li>
              )}
              {c.email && !isPlaceholder(c.email) && (
                <li>
                  <a class="contact__channel" href={`mailto:${c.email}`}>
                    <span class="contact__channel-label">Email</span>
                    <span class="contact__channel-value">{c.email}</span>
                    <span class="contact__channel-arrow" aria-hidden="true">→</span>
                  </a>
                </li>
              )}
            </ul>
          ) : (
            <p class="contact__pending">Próximamente publicaremos los datos de contacto de {c.name}.</p>
          )}
        </article>
      ))}
    </div>

    {!anyContact && (
      <p class="contact__soon reveal">
        Mientras tanto, síguenos en redes y estate atent@ a esta web.
      </p>
    )}
  </div>
</section>

<style>
  .contact {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--c-orange);
    color: var(--c-black);
    padding: var(--section-pad-y) 0;
  }
  .contact__decor { position: absolute; inset: 0; z-index: 0; pointer-events: none; }
  .contact__decor :global(.contact__burst) {
    position: absolute;
    top: 4%;
    right: -6%;
    width: clamp(110px, 22vw, 220px);
    animation: spin-slow 30s linear infinite;
    opacity: 0.95;
  }
  .contact__decor :global(.contact__squiggle) {
    position: absolute;
    top: 50%;
    left: 6%;
  }
  .contact__decor :global(.contact__star) {
    position: absolute;
    bottom: 6%;
    left: 8%;
    animation: spin-slow 18s linear infinite;
  }

  .contact__container { position: relative; z-index: 1; }
  .contact__header { text-align: center; max-width: 36rem; margin: 0 auto 2.5rem; }
  .contact__title { color: var(--c-black); margin-top: 0.6rem; }
  .contact__lead { margin-top: 1rem; font-size: 1.1rem; line-height: 1.4; }

  .contact__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
    max-width: 56rem;
    margin: 0 auto;
  }

  .contact__card {
    border: 4px solid var(--c-black);
    border-radius: var(--br-lg);
    padding: clamp(1.4rem, 3vw, 2rem);
    box-shadow: var(--shadow-2);
    display: flex;
    flex-direction: column;
    gap: 1rem;
    position: relative;
  }
  .contact__card--a {
    background: var(--c-cream);
    color: var(--c-black);
    transform: rotate(-1.2deg);
  }
  .contact__card--b {
    background: var(--c-black);
    color: var(--c-cream);
    transform: rotate(1.2deg);
  }
  .contact__card--b .contact__channel {
    background: var(--c-cream);
    color: var(--c-black);
  }

  .contact__card-head { display: flex; align-items: center; gap: 0.9rem; }
  .contact__avatar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.5rem;
    height: 3.5rem;
    background: var(--c-pink);
    color: var(--c-black);
    border: 3px solid var(--c-black);
    border-radius: 50%;
    font-family: var(--ff-display);
    font-size: 1.6rem;
  }
  .contact__card--b .contact__avatar {
    background: var(--c-butter);
  }
  .contact__name {
    font-family: var(--ff-display);
    font-size: 1.6rem;
    line-height: 1;
  }
  .contact__role {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--c-purple);
  }
  .contact__card--b .contact__role { color: var(--c-butter); }

  .contact__channels {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  .contact__channel {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: 0.2rem 1rem;
    background: var(--c-white);
    border: 2px solid var(--c-black);
    border-radius: var(--br-md);
    padding: 0.8rem 1rem;
    transition: transform var(--d-fast) var(--ease-snap);
  }
  .contact__channel:hover,
  .contact__channel:focus-visible {
    transform: translateX(4px);
    outline: 0;
  }
  .contact__channel-label {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--c-purple);
  }
  .contact__channel-value {
    font-family: var(--ff-display);
    font-size: 1.1rem;
    color: var(--c-black);
    grid-column: 1;
  }
  .contact__channel-arrow {
    grid-row: 1 / span 2;
    grid-column: 2;
    align-self: center;
    font-size: 1.4rem;
    color: var(--c-orange);
  }
  .contact__pending {
    background: var(--c-butter);
    color: var(--c-black);
    padding: 0.8rem 1rem;
    border: 2px dashed var(--c-black);
    border-radius: var(--br-md);
    font-weight: 600;
  }
  .contact__soon {
    margin: 2rem auto 0;
    text-align: center;
    background: var(--c-black);
    color: var(--c-butter);
    padding: 1rem 1.4rem;
    border-radius: var(--br-md);
    max-width: 36rem;
    font-weight: 600;
  }

  @media (min-width: 720px) {
    .contact__grid { grid-template-columns: 1fr 1fr; }
  }
</style>
