---
import cfg from '../data/wedding.ts';
import { isPlaceholder } from '../data/wedding.ts';
import Concentric from './decorations/Concentric.astro';
import Squiggle from './decorations/Squiggle.astro';
import Star from './decorations/Star.astro';

const namePlaceholder = isPlaceholder(cfg.venue.name);
const addressPlaceholder = isPlaceholder(cfg.venue.address);
const mapsUrl = cfg.venue.mapsUrl;
const hasMaps = !isPlaceholder(mapsUrl);
---

<section id="ubicacion" class="loc" data-bg="cream">
  <div class="loc__decor" aria-hidden="true">
    <Concentric size="220" className="loc__concentric" />
    <Squiggle color="#FF651F" width="200" height="28" className="loc__squiggle" />
    <Star size="50" color="#5423A6" points={8} rotate={20} className="loc__star" />
  </div>

  <div class="container loc__container">
    <div class="loc__header reveal">
      <span class="eyebrow"><span aria-hidden="true">◉</span> 03 · Dónde</span>
      <h2 class="loc__title section-title">{cfg.copy.locationHeading}</h2>
    </div>

    <div class="loc__layout">
      <article class="loc__card reveal">
        <div class="loc__card-top">
          <span class="loc__num">→ 04</span>
          <span class="loc__card-eyebrow">Venue</span>
        </div>

        <h3 class="loc__venue">
          {namePlaceholder ? 'Próximamente' : cfg.venue.name}
        </h3>
        <p class="loc__address">
          {addressPlaceholder
            ? 'Dirección por confirmar'
            : cfg.venue.address}
          {cfg.venue.city && <span class="loc__city">, {cfg.venue.city}</span>}
        </p>

        {cfg.event.arrivalTime && (
          <div class="loc__arrival">
            <span>{cfg.copy.locationArrivalLabel}</span>
            <strong>{cfg.event.arrivalTime}</strong>
          </div>
        )}

        <div class="loc__actions">
          {hasMaps ? (
            <a class="btn btn--pink" href={mapsUrl} target="_blank" rel="noopener noreferrer">
              Cómo llegar
              <span aria-hidden="true">↗</span>
            </a>
          ) : (
            <span class="loc__pending">Próximamente publicaremos el enlace al mapa.</span>
          )}
        </div>
      </article>

      <aside class="loc__map reveal" aria-hidden={hasMaps ? 'false' : 'true'}>
        <div class="loc__map-art">
          <div class="loc__map-grid"></div>
          <div class="loc__map-pin" aria-hidden="true">
            <span class="loc__pin-dot"></span>
            <span class="loc__pin-pulse"></span>
          </div>
          <div class="loc__map-stickers">
            <span class="loc__sticker loc__sticker--1">AQUÍ</span>
            <span class="loc__sticker loc__sticker--2">→ Música</span>
            <span class="loc__sticker loc__sticker--3">← Baile</span>
          </div>
        </div>
        <p class="loc__map-caption">
          {hasMaps
            ? 'Pulsa el botón para abrir Google Maps y trazar tu ruta.'
            : 'Cuando cerremos el venue añadiremos aquí un plano ilustrado.'}
        </p>
      </aside>
    </div>
  </div>
</section>

<style>
  .loc {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--c-cream);
    padding: var(--section-pad-y) 0;
  }
  .loc__decor { position: absolute; inset: 0; z-index: 0; pointer-events: none; }
  .loc__decor :global(.loc__concentric) {
    position: absolute;
    top: 8%;
    left: -6%;
    animation: spin-slow 50s linear infinite;
  }
  .loc__decor :global(.loc__squiggle) {
    position: absolute;
    top: 50%;
    left: 4%;
  }
  .loc__decor :global(.loc__star) {
    position: absolute;
    bottom: 6%;
    right: 6%;
    animation: spin-slow 20s linear infinite;
  }

  .loc__container { position: relative; z-index: 1; }

  .loc__header { text-align: center; margin-bottom: 2.5rem; }
  .loc__title { color: var(--c-black); }

  .loc__layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }

  .loc__card {
    background: var(--c-purple);
    color: var(--c-cream);
    border: 4px solid var(--c-black);
    border-radius: var(--br-lg);
    padding: clamp(1.4rem, 3vw, 2.2rem);
    box-shadow: var(--shadow-3);
    transform: rotate(-1deg);
    position: relative;
  }
  .loc__card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1rem;
  }
  .loc__num {
    font-family: var(--ff-display);
    font-size: 1.1rem;
    color: var(--c-butter);
  }
  .loc__card-eyebrow {
    background: var(--c-butter);
    color: var(--c-black);
    border: 2px solid var(--c-black);
    padding: 0.15rem 0.7rem;
    border-radius: 999px;
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .loc__venue {
    font-family: var(--ff-display);
    font-size: clamp(1.8rem, 5vw, 2.8rem);
    line-height: 1;
    color: var(--c-cream);
    margin-bottom: 0.6rem;
  }
  .loc__address {
    font-size: 1.05rem;
    color: var(--c-cream);
    line-height: 1.4;
  }
  .loc__city { color: var(--c-butter); font-weight: 600; }
  .loc__arrival {
    margin-top: 1.2rem;
    display: inline-flex;
    flex-direction: column;
    gap: 0.1rem;
    background: var(--c-butter);
    color: var(--c-black);
    padding: 0.5rem 0.9rem;
    border: 2px solid var(--c-black);
    border-radius: var(--br-md);
  }
  .loc__arrival span {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .loc__arrival strong {
    font-family: var(--ff-display);
    font-size: 1.4rem;
  }
  .loc__actions { margin-top: 1.4rem; display: flex; align-items: center; gap: 0.8rem; flex-wrap: wrap; }
  .loc__actions .btn { background: var(--c-pink); color: var(--c-black); }
  .loc__actions .btn:hover { background: var(--c-butter); }
  .loc__pending {
    background: var(--c-butter);
    color: var(--c-black);
    padding: 0.6rem 1rem;
    border-radius: var(--br-md);
    border: 2px solid var(--c-black);
    font-weight: 600;
  }

  /* Map art */
  .loc__map {
    background: var(--c-orange);
    color: var(--c-black);
    border: 4px solid var(--c-black);
    border-radius: var(--br-lg);
    padding: clamp(1.2rem, 3vw, 2rem);
    box-shadow: var(--shadow-2);
    transform: rotate(1.2deg);
    position: relative;
  }
  .loc__map-art {
    position: relative;
    aspect-ratio: 1.2 / 1;
    border: 3px solid var(--c-black);
    border-radius: var(--br-md);
    background:
      radial-gradient(circle at 30% 30%, #ffd84d 0 14%, transparent 14.5%),
      radial-gradient(circle at 75% 65%, #ff65b3 0 18%, transparent 18.5%),
      linear-gradient(135deg, #fff5df 0%, #fbe9c2 100%);
    overflow: hidden;
  }
  .loc__map-grid {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, transparent calc(20% - 1px), rgba(25,20,20,0.15) 20% 21%, transparent 21%) 0 0/100% 25%,
      linear-gradient(0deg, transparent calc(20% - 1px), rgba(25,20,20,0.15) 20% 21%, transparent 21%) 0 0/25% 100%;
  }
  .loc__map-pin {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -100%);
  }
  .loc__pin-dot {
    display: block;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--c-black);
    border: 3px solid var(--c-butter);
    box-shadow: 0 0 0 3px var(--c-black);
  }
  .loc__pin-pulse {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--c-pink);
    opacity: 0.6;
    animation: pin-pulse 1.6s ease-out infinite;
  }
  @keyframes pin-pulse {
    0% { transform: scale(1); opacity: 0.7; }
    100% { transform: scale(3.2); opacity: 0; }
  }
  .loc__map-stickers {
    position: absolute;
    inset: 0;
  }
  .loc__sticker {
    position: absolute;
    background: var(--c-black);
    color: var(--c-butter);
    border: 2px solid var(--c-butter);
    border-radius: 999px;
    padding: 0.2rem 0.7rem;
    font-family: var(--ff-display);
    font-size: 0.85rem;
  }
  .loc__sticker--1 { top: 10%; left: 10%; transform: rotate(-6deg); }
  .loc__sticker--2 { top: 12%; right: 8%; transform: rotate(8deg); }
  .loc__sticker--3 { bottom: 14%; left: 8%; transform: rotate(6deg); }
  .loc__map-caption {
    margin-top: 1rem;
    font-size: 0.95rem;
    color: var(--c-black);
    line-height: 1.4;
  }

  @media (min-width: 880px) {
    .loc__layout {
      grid-template-columns: 1.1fr 1fr;
      gap: 2.5rem;
    }
  }
</style>
