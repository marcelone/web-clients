---
import cfg from '../data/wedding.ts';
import DiscoBall from './decorations/DiscoBall.astro';
import Flower from './decorations/Flower.astro';
import Star from './decorations/Star.astro';
import Burst from './decorations/Burst.astro';
import Squiggle from './decorations/Squiggle.astro';
import Concentric from './decorations/Concentric.astro';
---

<section id="top" class="hero">
  <div class="hero__bg" aria-hidden="true">
    <div class="hero__stripes"></div>
    <div class="hero__noise"></div>
  </div>

  <div class="hero__deco" aria-hidden="true">
    <Flower size="180" color="#FF65B3" accent="#FFD84D" rotate={-12} className="hero__flower hero__flower--1" />
    <Flower size="120" color="#FFD84D" accent="#FF651F" variant="b" rotate={20} className="hero__flower hero__flower--2" />
    <Flower size="90" color="#5423A6" accent="#FF65B3" variant="c" rotate={-30} className="hero__flower hero__flower--3" />
    <Star size="80" color="#FFD84D" rotate={15} className="hero__star hero__star--1" />
    <Star size="48" color="#FF651F" points={8} rotate={-10} className="hero__star hero__star--2" />
    <Burst size="160" color="#5423A6" accent="#FF65B3" rotate={-8} className="hero__burst" />
    <Concentric size="120" className="hero__concentric" />
    <Squiggle color="#191414" width="220" height="32" className="hero__squiggle" />
  </div>

  <div class="hero__inner container">
    <div class="hero__eyebrow">
      <span class="hero__eyebrow-dot"></span>
      <span>Save the date · {cfg.couple.hashtag}</span>
    </div>

    <h1 class="hero__title display">
      <span class="hero__name hero__name--miguel">Miguel</span>
      <span class="hero__amp-row">
        <span class="hero__amp">&amp;</span>
      </span>
      <span class="hero__name hero__name--fran">Fran</span>
    </h1>

    <div class="hero__disco" data-tilt aria-hidden="true">
      <DiscoBall size="100%" color="#FFD84D" accent="#FFF5DF" speed={28} />
      <span class="hero__disco-tag">Disco&nbsp;Ball</span>
    </div>

    <p class="hero__subtitle">
      <span aria-hidden="true">✦</span>
      <span>{cfg.copy.heroSubtitle}</span>
      <span aria-hidden="true">✦</span>
    </p>

    <p class="hero__claim">{cfg.copy.heroClaim}</p>

    <div class="hero__cta">
      <a class="btn" href="#fecha">
        <span>¡Descubre el plan!</span>
        <span aria-hidden="true">↓</span>
      </a>
      <a class="hero__cta-ghost" href="#contacto">¿Dudas? Escríbenos</a>
    </div>

    <a class="hero__scroll" href="#fecha" aria-label="Desplázate hacia abajo">
      <span class="hero__scroll-label">Scroll</span>
      <span class="hero__scroll-line" aria-hidden="true"></span>
    </a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: 100svh;
    min-height: 100dvh;
    background: var(--c-orange);
    color: var(--c-black);
    padding: 6.5rem 0 3rem;
  }

  /* Diagonal stripes background */
  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
  }
  .hero__stripes {
    position: absolute;
    inset: -10%;
    background:
      repeating-linear-gradient(
        45deg,
        transparent 0 28px,
        rgba(25, 20, 20, 0.07) 28px 56px
      );
  }
  .hero__noise {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 80% 10%, rgba(255, 101, 179, 0.45), transparent 45%),
      radial-gradient(circle at 10% 90%, rgba(84, 35, 166, 0.45), transparent 45%);
  }

  /* Decorative floating elements */
  .hero__deco {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }
  .hero__deco :global(.hero__flower) {
    position: absolute;
  }
  .hero__deco :global(.hero__flower--1) {
    top: 6%;
    left: -8%;
    width: clamp(100px, 22vw, 180px);
    animation: float 6s ease-in-out infinite;
  }
  .hero__deco :global(.hero__flower--2) {
    bottom: 18%;
    right: -4%;
    width: clamp(80px, 18vw, 120px);
    animation: float 8s ease-in-out -2s infinite;
  }
  .hero__deco :global(.hero__flower--3) {
    top: 38%;
    right: -8%;
    width: clamp(70px, 14vw, 90px);
    animation: float 7s ease-in-out -4s infinite;
  }
  .hero__deco :global(.hero__star--1) {
    top: 30%;
    left: 4%;
    width: clamp(50px, 8vw, 80px);
    animation: spin-slow 22s linear infinite, float 5s ease-in-out infinite;
  }
  .hero__deco :global(.hero__star--2) {
    bottom: 12%;
    left: 4%;
    width: clamp(36px, 6vw, 48px);
    animation: spin-slow-rev 18s linear infinite;
  }
  .hero__deco :global(.hero__burst) {
    top: 4%;
    right: -6%;
    width: clamp(70px, 14vw, 160px);
    animation: spin-slow 40s linear infinite;
    opacity: 0.85;
  }
  .hero__deco :global(.hero__concentric) {
    bottom: 6%;
    right: 4%;
    width: clamp(50px, 8vw, 120px);
    animation: spin-slow-rev 28s linear infinite;
    opacity: 0.85;
  }
  .hero__deco :global(.hero__squiggle) {
    position: absolute;
    top: 60%;
    left: 4%;
    width: clamp(90px, 18vw, 240px);
  }

  /* Inner composition */
  .hero__inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.1rem;
    text-align: center;
  }

  .hero__eyebrow {
    justify-self: center;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.5rem 1rem;
    background: var(--c-black);
    color: var(--c-butter);
    border-radius: 999px;
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }
  .hero__eyebrow-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--c-pink);
    box-shadow: 0 0 0 3px var(--c-pink);
    animation: pulse-glow 1.6s ease-in-out infinite;
  }

  .hero__title {
    position: relative;
    margin: 0.4rem 0 0.2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
    line-height: 0.85;
  }
  .hero__name {
    display: block;
    font-size: clamp(5rem, 17vw, 12rem);
    letter-spacing: -0.02em;
    line-height: 0.88;
  }
  .hero__name--miguel {
    color: var(--c-black);
    transform: rotate(-2deg);
  }
  .hero__name--fran {
    color: var(--c-pink);
    transform: rotate(2deg);
    text-shadow:
      4px 4px 0 var(--c-black),
      8px 8px 0 var(--c-butter);
  }
  .hero__amp-row {
    display: flex;
    align-items: center;
    justify-content: center;
    margin: -0.15em 0;
  }
  .hero__amp {
    display: inline-block;
    font-family: var(--ff-display);
    font-size: clamp(2rem, 6vw, 4rem);
    color: var(--c-black);
    background: var(--c-butter);
    border: 3px solid var(--c-black);
    border-radius: 50%;
    width: 1.6em;
    height: 1.6em;
    line-height: 1.4em;
    box-shadow: var(--shadow-1);
    transform: rotate(-6deg);
  }

  /* Disco ball composition */
  .hero__disco {
    position: relative;
    width: clamp(120px, 26vw, 200px);
    aspect-ratio: 1;
    justify-self: center;
    transition: transform 600ms var(--ease-out);
    will-change: transform;
  }
  .hero__disco::before {
    content: '';
    position: absolute;
    inset: -22% -22% -34% -22%;
    background: radial-gradient(closest-side, rgba(255, 216, 77, 0.65), transparent 70%);
    z-index: -1;
    border-radius: 50%;
  }
  .hero__disco-tag {
    position: absolute;
    top: -8px;
    right: -10px;
    background: var(--c-black);
    color: var(--c-butter);
    font-family: var(--ff-display);
    font-size: 0.8rem;
    padding: 0.25rem 0.6rem;
    border-radius: 999px;
    transform: rotate(8deg);
    border: 2px solid var(--c-butter);
  }

  .hero__subtitle {
    display: inline-flex;
    justify-self: center;
    align-items: center;
    gap: 0.6rem;
    font-family: var(--ff-display);
    font-size: clamp(1.3rem, 3.5vw, 2.2rem);
    color: var(--c-black);
    background: var(--c-cream);
    border: 3px solid var(--c-black);
    border-radius: 999px;
    padding: 0.5rem 1.2rem;
    box-shadow: var(--shadow-1);
    transform: rotate(-1.5deg);
  }
  .hero__subtitle span:nth-child(1),
  .hero__subtitle span:nth-child(3) {
    color: var(--c-orange);
  }

  .hero__claim {
    font-family: var(--ff-display);
    font-size: clamp(1.05rem, 2.4vw, 1.45rem);
    color: var(--c-black);
    max-width: 32ch;
    margin: 0.3rem auto 0;
    line-height: 1.2;
  }

  .hero__cta {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.8rem;
    margin-top: 0.6rem;
  }
  .hero__cta-ghost {
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--c-black);
    border-bottom: 2px solid var(--c-black);
    padding-bottom: 2px;
  }
  .hero__cta-ghost:hover { color: var(--c-pink); border-color: var(--c-pink); }

  .hero__scroll {
    justify-self: center;
    margin-top: 0.8rem;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
    color: var(--c-black);
  }
  .hero__scroll-label {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.4em;
    text-transform: uppercase;
  }
  .hero__scroll-line {
    width: 2px;
    height: 38px;
    background: var(--c-black);
    border-radius: 999px;
    position: relative;
    overflow: hidden;
  }
  .hero__scroll-line::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--c-butter);
    animation: scroll-down 1.6s ease-in-out infinite;
  }
  @keyframes scroll-down {
    0% { transform: translateY(-100%); }
    100% { transform: translateY(100%); }
  }

  /* ---------- Desktop composition ---------- */
  @media (min-width: 880px) {
    .hero {
      padding: 5rem 0 4rem;
    }
    .hero__inner {
      grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.7fr);
      grid-template-areas:
        'eyebrow eyebrow'
        'title disco'
        'subtitle disco'
        'claim disco'
        'cta disco'
        'scroll disco';
      text-align: left;
      align-items: center;
      column-gap: 1.5rem;
      row-gap: 1.4rem;
    }
    .hero__eyebrow { grid-area: eyebrow; justify-self: start; }
    .hero__title {
      grid-area: title;
      align-items: flex-start;
    }
    .hero__disco {
      grid-area: disco;
      justify-self: center;
      align-self: center;
      width: clamp(220px, 28vw, 360px);
    }
    .hero__subtitle { grid-area: subtitle; justify-self: start; }
    .hero__claim { grid-area: claim; margin: 0; max-width: 50ch; }
    .hero__cta { grid-area: cta; flex-direction: row; align-items: center; justify-self: start; }
    .hero__scroll { grid-area: scroll; justify-self: start; }

    .hero__name--miguel { transform: translateX(-2%) rotate(-3deg); }
    .hero__name--fran { transform: translateX(4%) rotate(2deg); }

    [data-tilt] {
      transform: rotate(calc(var(--tx, 0) * 0.4)) translateY(calc(var(--ty, 0) * 0.4px));
    }

    /* hide some decorative clutter on desktop to let disco shine */
    .hero__deco :global(.hero__flower--3),
    .hero__deco :global(.hero__star--1) {
      display: none;
    }
  }
</style>
