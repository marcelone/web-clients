---
import '../styles/global.css';
import cfg from '../data/wedding.ts';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}
const {
  title = cfg.seo.title,
  description = cfg.seo.description,
  ogImage = cfg.seo.image ?? '/og-image.svg',
} = Astro.props;

const url = cfg.seo.url ?? Astro.url.href;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#FF651F" />
    <meta name="color-scheme" content="light" />

    <title>{title}</title>
    <meta name="description" content={description} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="canonical" href={url} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={url} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="es_ES" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>
  <body>
    <a href="#fecha" class="skip-link">Saltar al contenido</a>
    <slot />

    <script>
      /* Scroll reveal: lightweight IntersectionObserver */
      (() => {
        const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
        const targets = document.querySelectorAll<HTMLElement>('.reveal, .stagger');
        if (!targets.length) return;

        if (reduced || !('IntersectionObserver' in window)) {
          targets.forEach((el) => el.classList.add('is-in'));
          return;
        }

        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (e.isIntersecting) {
                e.target.classList.add('is-in');
                io.unobserve(e.target);
              }
            });
          },
          { threshold: 0.15, rootMargin: '0px 0px -8% 0px' }
        );
        targets.forEach((el) => io.observe(el));
      })();

      /* Subtle parallax for items with [data-parallax] */
      (() => {
        const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
        const items = document.querySelectorAll<HTMLElement>('[data-parallax]');
        if (reduced || !items.length) return;

        let raf = 0;
        const update = () => {
          raf = 0;
          const y = window.scrollY;
          items.forEach((el) => {
            const speed = parseFloat(el.dataset.parallax || '0.15');
            const offset = y * speed;
            el.style.setProperty('--py', `${offset.toFixed(1)}px`);
          });
        };

        const onScroll = () => {
          if (raf) return;
          raf = requestAnimationFrame(update);
        };
        window.addEventListener('scroll', onScroll, { passive: true });
        update();
      })();

      /* Hero disco ball subtly follows pointer */
      (() => {
        const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
        const ball = document.querySelector<HTMLElement>('[data-tilt]');
        if (!ball || reduced) return;

        const onMove = (e: PointerEvent) => {
          const x = (e.clientX / window.innerWidth - 0.5) * 14;
          const y = (e.clientY / window.innerHeight - 0.5) * 14;
          ball.style.setProperty('--tx', `${x.toFixed(1)}deg`);
          ball.style.setProperty('--ty', `${y.toFixed(1)}deg`);
        };
        window.addEventListener('pointermove', onMove, { passive: true });
      })();
    </script>

    <style>
      .skip-link {
        position: absolute;
        top: -100px;
        left: 1rem;
        background: #191414;
        color: #ffd84d;
        padding: 0.75rem 1rem;
        border-radius: 999px;
        font-weight: 600;
        z-index: 1000;
        transition: top 200ms;
      }
      .skip-link:focus {
        top: 1rem;
        outline: 3px dashed #ff651f;
        outline-offset: 3px;
      }
    </style>
  </body>
</html>
